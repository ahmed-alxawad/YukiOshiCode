exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi acp --help 1`] = `
"yukioshi acp

start ACP (Agent Client Protocol) server

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                          [boolean]
      --port         port to listen on (0 tries 4096, then any free port)      [number] [default: 0]
      --hostname     hostname to listen on                           [string] [default: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain  custom domain name for mDNS service (default: yukioshi.local)
                                                                [string] [default: "yukioshi.local"]
      --cors         additional domains to allow for CORS                      [array] [default: []]
      --cwd          working directory [string] [default: "<HOME>"]"
`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi mcp --help 1`] = `
"yukioshi mcp

manage MCP (Model Context Protocol) servers

Commands:
  yukioshi mcp add [name]     add an MCP server
  yukioshi mcp list           list MCP servers and their status                        [aliases: ls]
  yukioshi mcp auth [name]    authenticate with an OAuth-enabled MCP server
  yukioshi mcp logout [name]  remove OAuth credentials for an MCP server
  yukioshi mcp debug <name>   debug OAuth connection for an MCP server

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi attach --help 1`] = `
"yukioshi attach <url>

attach to a running yukioshi server

Positionals:
  url  address of a running server, for example http://localhost:4096 (start one with \`yukioshi
       serve\`)                                                                   [string] [required]

Options:
  -h, --help          show help                                                            [boolean]
  -v, --version       show version number                                                  [boolean]
      --print-logs    print logs to stderr                                                 [boolean]
      --log-level     log level                 [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure          run without external plugins                                         [boolean]
      --dir           directory to run in                                                   [string]
  -c, --continue      continue the last session                                            [boolean]
  -s, --session       session id to continue                                                [string]
      --fork          fork the session when continuing (use with --continue or --session)  [boolean]
  -p, --password      basic auth password (defaults to YUKIOSHI_SERVER_PASSWORD)            [string]
  -u, --username      basic auth username (defaults to YUKIOSHI_SERVER_USERNAME or 'yukioshi')
                                                                                            [string]
      --mini          start the minimal interactive interface             [boolean] [default: false]
      --no-replay     disable mini session history replay on resume and after resize       [boolean]
      --replay-limit  cap visible mini replay to the newest N messages                      [number]"
`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi run --help 1`] = `
"yukioshi run [message..]

run yukioshi with a message

Positionals:
  message  message to send                                                     [array] [default: []]

Options:
  -h, --help           show help                                                           [boolean]
  -v, --version        show version number                                                 [boolean]
      --print-logs     print logs to stderr                                                [boolean]
      --log-level      log level                [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure           run without external plugins                                        [boolean]
      --command        the command to run, use message for args                             [string]
  -c, --continue       continue the last session                                           [boolean]
  -s, --session        session id to continue                                               [string]
      --fork           fork the session before continuing (requires --continue or --session)
                                                                                           [boolean]
      --share          share the session                                                   [boolean]
  -m, --model          model to use in the format of provider/model                         [string]
      --agent          mode or agent: build, plan, goal, reasoning, research, auto, or a custom
                       agent                                                                [string]
      --format         format: default (formatted) or json (raw JSON events)
                                          [string] [choices: "default", "json"] [default: "default"]
  -f, --file           file(s) to attach to message                                          [array]
      --title          title for the session (uses truncated prompt if no value provided)   [string]
      --attach         attach to a running yukioshi server (e.g., http://localhost:4096)    [string]
  -p, --password       basic auth password (defaults to YUKIOSHI_SERVER_PASSWORD)           [string]
  -u, --username       basic auth username (defaults to YUKIOSHI_SERVER_USERNAME or 'yukioshi')
                                                                                            [string]
      --dir            directory to run in, path on remote server if attaching              [string]
      --worktree       run in a git worktree of this project with this name (created if needed)
                                                                                            [string]
      --port           port for the local server (defaults to random port if no value provided)
                                                                                            [number]
      --variant        model variant (provider-specific reasoning effort, e.g., high, max, minimal)
                                                                                            [string]
      --thinking       show thinking blocks                                                [boolean]
  -i, --interactive    run in direct interactive split-footer mode        [boolean] [default: false]
      --verify         run full project verification on changed files (off by default)
                                                                          [boolean] [default: false]
      --skip-verify    skip verification checks after turn completion                      [boolean]
      --summary        print the files changed after the turn (--no-summary to turn off)
                                                                           [boolean] [default: true]
      --output-schema  JSON Schema (a file, or inline JSON) the final answer must match; the answer
                       is printed as JSON                                                   [string]
      --max-turns      stop after this many model turns (exit code 5)                       [number]
      --max-cost       stop once this run has cost this many dollars (exit code 6)          [number]
      --auto           auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]
      --mode           permission mode for this session: manual asks for anything not explicitly
                       configured, auto auto-approves low-risk actions (reads/searches), auto-all
                       auto-approves anything not explicitly denied or hard-blocked, plan restricts
                       the agent to low-risk actions only, review has a small model approve or
                       refuse each action that is not low-risk
                                  [string] [choices: "manual", "auto", "auto-all", "plan", "review"]

Examples:
  yukioshi run "explain what this repo does"          send one message and print the answer
  yukioshi run -c "now add tests"                     continue the last session
  yukioshi run -m anthropic/claude-sonnet-4-5 "fix    pick the model for this run
  the failing test"
  git diff | yukioshi run "review this change"        pipe text in as extra context"
`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi debug --help 1`] = `
"yukioshi debug

debugging and troubleshooting tools

Commands:
  yukioshi debug config        show resolved configuration
  yukioshi debug lsp           LSP debugging utilities
  yukioshi debug rg            ripgrep debugging utilities
  yukioshi debug file          file system debugging utilities
  yukioshi debug scrap         list all known projects
  yukioshi debug skill         list all available skills
  yukioshi debug snapshot      snapshot debugging utilities
  yukioshi debug startup       print startup timing
  yukioshi debug agent <name>  show agent configuration details
  yukioshi debug v2            debug v2 catalog and built-in plugins
  yukioshi debug info          show debug information
  yukioshi debug paths         show global paths (data, config, cache, state)
  yukioshi debug wait          wait indefinitely (for debugging)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]"
`;

