exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi trust --help 1`] = `
"yukioshi trust [directory]

allow this project to run its own hooks, plugins, and commands

Positionals:
  directory  project directory (defaults to the current directory)                          [string]

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]
      --revoke      remove previously granted project trust               [boolean] [default: false]
      --status      show whether the project is trusted without changing it
