#!/usr/bin/env bash

# This installer needs bash. When it is piped to `sh` (dash on Debian/Ubuntu),
# re-run it under bash instead of failing on bash-only syntax.
# Test-only: YUKIOSHI_INSTALL_SHA256SUMS_URL overrides the release checksum URL.
if [ -z "${BASH_VERSION:-}" ]; then
    if command -v bash >/dev/null 2>&1; then
        if [ -f "$0" ] && grep -q "YukiOshi Code Installer" "$0" 2>/dev/null; then
            exec bash "$0" "$@"
        fi
        curl -fsSL "https://raw.githubusercontent.com/${YUKIOSHI_GITHUB_REPO:-ahmed-alxawad/YukiOshiCode}/main/install" | bash -s -- "$@"
        exit $?
    fi
    echo "The YukiOshi Code installer requires bash." >&2
    exit 1
fi

set -euo pipefail
APP=yukioshi
GITHUB_REPO=${YUKIOSHI_GITHUB_REPO:-ahmed-alxawad/YukiOshiCode}
GITHUB_URL="https://github.com/$GITHUB_REPO"

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
YukiOshi Code Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 0.3.0)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://raw.githubusercontent.com/ahmed-alxawad/YukiOshiCode/main/install | bash
    curl -fsSL https://raw.githubusercontent.com/ahmed-alxawad/YukiOshiCode/main/install | bash -s -- --version 0.3.0
    ./install --binary /path/to/yukioshi
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.yukioshi/bin
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    if [ -z "$requested_version" ]; then
        url="$GITHUB_URL/releases/latest/download/$filename"
        checksum_url="$GITHUB_URL/releases/latest/download/SHA256SUMS"
        specific_version=$(curl -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')

        if [[ $? -ne 0 || -z "$specific_version" ]]; then
            echo -e "${RED}Failed to fetch version information${NC}"
            exit 1
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        url="$GITHUB_URL/releases/download/v${requested_version}/$filename"
        checksum_url="$GITHUB_URL/releases/download/v${requested_version}/SHA256SUMS"
        specific_version=$requested_version

        # Verify the release exists before downloading
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "$GITHUB_URL/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: $GITHUB_URL/releases${NC}"
            exit 1
        fi
    fi

    if [ -n "${YUKIOSHI_INSTALL_SHA256SUMS_URL:-}" ]; then
        checksum_url="$YUKIOSHI_INSTALL_SHA256SUMS_URL"
    fi
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v yukioshi >/dev/null 2>&1; then
        ## Check the installed version
        installed_version=$(yukioshi --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        else
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad
        pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled
    filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty
    empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/yukioshi_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap 'trap - RETURN; rm -f "$tracefile"; printf "\033[?25h" >&4; exec 4>&-' RETURN

    (
        curl --trace-ascii "$tracefile" -s -f -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

verify_archive_checksum() {
    local archive_path="$1"
    local checksum_path="$2"
    local selected_checksum="$3"
    local checksum_line=""
    local found=false

    while IFS= read -r checksum_line || [ -n "$checksum_line" ]; do
        if [[ "$checksum_line" =~ ^([[:xdigit:]]{64})[[:space:]]+\*?(.+)$ ]] && [ "${BASH_REMATCH[2]}" = "$filename" ]; then
            printf '%s  %s\n' "${BASH_REMATCH[1]}" "$filename" > "$selected_checksum"
            found=true
            break
        fi
    done < "$checksum_path"

    if [ "$found" != "true" ]; then
        print_message error "Error: ${filename} is not listed in SHA256SUMS; refusing to install it."
        return 1
    fi

    local archive_dir
    archive_dir=$(dirname "$archive_path")
    if command -v sha256sum >/dev/null 2>&1; then
        if ! (cd "$archive_dir" && sha256sum -c "$selected_checksum"); then
            print_message error "Error: Checksum verification failed for ${filename}; the archive was not installed."
            return 1
        fi
    elif command -v shasum >/dev/null 2>&1; then
        if ! (cd "$archive_dir" && shasum -a 256 -c "$selected_checksum"); then
            print_message error "Error: Checksum verification failed for ${filename}; the archive was not installed."
            return 1
        fi
    else
        print_message error "Error: SHA256SUMS is available, but neither sha256sum nor shasum is installed."
        return 1
    fi
}

install_candidate() {
    local source="$1"
    local destination="${INSTALL_DIR}/yukioshi"
    local backup="${INSTALL_DIR}/yukioshi.old"
    local staged="${INSTALL_DIR}/.yukioshi.new.$$"
    local candidate_version=""
    local had_previous=false

    rm -f "$staged"
    if ! cp "$source" "$staged" || ! chmod 755 "$staged"; then
        rm -f "$staged"
        print_message error "Error: Failed to stage the new YukiOshi binary."
        return 1
    fi

    if ! candidate_version=$("$staged" --version 2>&1); then
        rm -f "$staged"
        print_message error "Error: The new YukiOshi binary failed its --version health check; the existing installation was not changed."
        return 1
    fi
    print_message info "${MUTED}Verified new binary version: ${NC}${candidate_version}"

    if [ -e "$destination" ]; then
        rm -f "$backup"
        mv "$destination" "$backup"
        had_previous=true
    fi

    if ! mv "$staged" "$destination"; then
        rm -f "$staged"
        if [ "$had_previous" = "true" ]; then
            mv "$backup" "$destination"
        fi
        print_message error "Error: Failed to install the new YukiOshi binary; the previous binary was restored."
        return 1
    fi
}

install_tmp_dir=""
cleanup_install_tmp() {
    if [ -n "$install_tmp_dir" ]; then
        rm -rf "$install_tmp_dir"
    fi
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}yukioshi ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/yukioshi_install_$$"
    mkdir -p "$tmp_dir"
    install_tmp_dir="$tmp_dir"
    trap cleanup_install_tmp EXIT

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        curl -# -f -L -o "$tmp_dir/$filename" "$url"
    fi

    local checksum_path="$tmp_dir/SHA256SUMS"
    local selected_checksum="$tmp_dir/SHA256SUMS.selected"
    if curl -fsSL -o "$checksum_path" "$checksum_url" 2>/dev/null; then
        print_message info "${MUTED}Verifying checksum for ${NC}${filename}"
        verify_archive_checksum "$tmp_dir/$filename" "$checksum_path" "$selected_checksum"
    else
        rm -f "$checksum_path"
        print_message warning "Warning: SHA256SUMS not found for this release (${checksum_url}). Continuing without checksum verification."
    fi

    if [ "$os" = "linux" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi

    local extracted_binary="$tmp_dir/yukioshi"
    if [ "$os" = "windows" ] && [ -f "$tmp_dir/yukioshi.exe" ]; then
        extracted_binary="$tmp_dir/yukioshi.exe"
    fi

    if [ ! -f "$extracted_binary" ]; then
        print_message error "Error: The downloaded archive does not contain a YukiOshi binary."
        return 1
    fi

    install_candidate "$extracted_binary"
    cleanup_install_tmp
    install_tmp_dir=""
    trap - EXIT
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}yukioshi ${MUTED}from: ${NC}$binary_path"
    install_candidate "$binary_path"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
    echo -e "\n# yukioshi" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}yukioshi ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${ORANGE}YukiOshi Code${NC}"
echo -e ""
echo -e "${MUTED}To start:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "yukioshi      ${MUTED}# Run command${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}$GITHUB_URL#readme"
echo -e ""
echo -e ""
