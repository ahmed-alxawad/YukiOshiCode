`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi checkpoint --help 1`] = `
"yukioshi checkpoint <action> [id]

list, inspect, restore, or prune durable git checkpoints

Positionals:
  action  list checkpoints, show or restore one by id, or prune old ones
                                            [required] [choices: "list", "show", "restore", "prune"]
  id      checkpoint commit id (for show or restore)                                        [string]

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]
      --session     limit list to a session id                                              [string]
      --yes         confirm restoring over unsaved changes                [boolean] [default: false]
      --older-than  prune refs older than this age (30d, 12h or 90m)       [string] [default: "30d"]

Examples:
  yukioshi checkpoint list                  list checkpoints for this project
  yukioshi checkpoint restore 1a2b3c4d5e6f  put the files back as they were at that checkpoint"
`;

exports[`yukioshi CLI help-text snapshots every documented command emits stable help text: yukioshi schedule --help 1`] = `
